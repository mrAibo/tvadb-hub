# Maintainer: DroidSphere contributors
pkgname=droidsphere
pkgver=0.1.0
pkgrel=1
pkgdesc="Cross-platform Android device manager powered by ADB, Fastboot and scrcpy"
arch=('x86_64')
url="https://github.com/mrAibo/tvadb-hub"
license=('MIT')
depends=('gtk4' 'webkitgtk-6.0')
provides=('droidsphere')
source=()
sha256sums=()

build() {
  cd "$startdir/../.."
  :
}

package() {
  cd "$startdir/../.."
  install -Dm755 bin/DroidSphere "$pkgdir/usr/bin/DroidSphere"
  install -Dm644 build/linux/DroidSphere.desktop "$pkgdir/usr/share/applications/DroidSphere.desktop"
  install -Dm644 build/appicon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/DroidSphere.png"
}
